---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import wordmark from '../assets/brand/logo-wordmark.png';
import wordmarkLight from '../assets/brand/logo-wordmark-light.png';
import stacked from '../assets/brand/logo-stacked.png';
import stackedLight from '../assets/brand/logo-stacked-light.png';
import circle from '../assets/brand/logo-circle.png';
import circleLight from '../assets/brand/logo-circle-light.png';
import monogram from '../assets/brand/monogram.png';

interface Props {
  variant?: 'wordmark' | 'stacked' | 'circle' | 'monogram';
  tone?: 'dark' | 'light';
  width: number;
  loading?: 'eager' | 'lazy';
  class?: string;
}
const { variant = 'wordmark', tone = 'dark', width, loading = 'lazy', class: cls } = Astro.props;

const sources = {
  wordmark: { dark: wordmark, light: wordmarkLight },
  stacked: { dark: stacked, light: stackedLight },
  circle: { dark: circle, light: circleLight },
  monogram: { dark: monogram, light: monogram },
};
---

<Image
  src={sources[variant][tone]}
  alt={site.name}
  width={width}
  densities={[1, 2]}
  loading={loading}
  class={cls}
/>
