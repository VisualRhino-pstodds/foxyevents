---
import { travel } from '../data/site';
---

<aside class="travel" id="travel">
  <div class="pin" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" />
      <circle cx="12" cy="9.5" r="2.5" />
    </svg>
  </div>
  <div>
    <h3>{travel.headline}</h3>
    <p class="summary">{travel.summary}</p>
    <p class="detail">{travel.detail}</p>
  </div>
</aside>

<style>
  .travel {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 24px;
    padding: clamp(24px, 4vw, 40px);
    background: var(--cream);
    border: 1px solid var(--line);
    border-left: 4px solid var(--copper);
    border-radius: var(--radius);
    scroll-margin-top: 96px;
  }
  .pin {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--ink);
    color: var(--copper);
  }
  h3 { margin-bottom: 0.25em; }
  .summary { font-weight: 700; }
  .detail { color: var(--ink-soft); margin: 0; }
  @media (max-width: 520px) {
    .travel { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
