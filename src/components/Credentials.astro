---
// "Licensed · Insured · Bonded" badge. Many venues require proof of all three.
import { site } from '../data/site';

interface Props {
  align?: 'start' | 'center';
  class?: string;
}
const { align = 'start', class: cls } = Astro.props;
---

<p class:list={['credentials', align, cls]}>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
    <path d="M12 2.5 4.5 5.5v6c0 4.6 3.1 8.6 7.5 10 4.4-1.4 7.5-5.4 7.5-10v-6L12 2.5Z" />
    <path d="m8.5 12 2.4 2.4 4.6-4.8" />
  </svg>
  <span>{site.credentials.join(' · ')}</span>
</p>

<style>
  .credentials {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .credentials.center { display: flex; justify-content: center; }
  svg { color: var(--copper); flex: none; }
  :global(.on-dark) .credentials,
  :global(.section--dark) .credentials { color: var(--cream); }
</style>
