---
import Layout from '../layouts/Layout.astro';
import Divider from '../components/Divider.astro';
import TravelNote from '../components/TravelNote.astro';
import ContactBand from '../components/ContactBand.astro';
import FaqList from '../components/FaqList.astro';
import { packages } from '../data/packages';
import { faqs } from '../data/faq';
import { site } from '../data/site';

const weddingFaqs = faqs.filter((f) => f.group === 'Weddings' || f.group === 'Booking & Pricing');

const schema = [
  {
    '@type': 'OfferCatalog',
    name: 'Foxy Events Wedding Packages',
    itemListElement: packages.map((p) => ({
      '@type': 'Offer',
      name: p.name,
      description: p.blurb,
      seller: { '@id': `${site.url}/#business` },
      priceSpecification: {
        '@type': 'PriceSpecification',
        minPrice: Number(p.price.replace(/[^0-9]/g, '')),
        priceCurrency: 'USD',
      },
      itemOffered: { '@type': 'Service', name: `Wedding ${p.name}`, serviceType: 'Wedding planning' },
    })),
  },
];
---

<Layout
  title="Wedding Coordinator Packages & Pricing"
  description="Wedding day-of coordination starting at $800 and full service wedding planning starting at $4,000. Based in Vancouver, WA, with free travel within 100 miles."
  schema={schema}
>
  <section class="section intro">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Wedding packages &amp; pricing</span>
        <h1>Your day, <span class="script">beautifully</span> handled</h1>
        <Divider align="center" />
        <p class="lede">
          Whether you’ve planned every detail or are just getting started, we’ll take care of the details so you can
          enjoy your day.
        </p>
      </div>

      <div class="packages">
        {
          packages.map((p) => (
            <article class:list={['pkg', { featured: p.featured, 'on-dark': p.featured }]}>
              {p.featured && <span class="badge">Most popular</span>}
              <span class="theme">{p.theme}</span>
              <h2>{p.name}</h2>
              <p class="price">{p.price}</p>
              <p class="hook">{p.hook}</p>
              <p class="blurb">{p.blurb}</p>

              <ul class="sparkle-list">
                {p.highlights.map((f) => <li>{f}</li>)}
              </ul>

              <details>
                <summary>See everything included ({p.features.length})</summary>
                <ul class="sparkle-list">
                  {p.features.map((f) => <li>{f}</li>)}
                </ul>
              </details>

              <div class="foot">
                {p.note && <p class="note">{p.note}</p>}
                <div class="btn-row">
                  <a class:list={['btn', p.featured ? 'btn--solid' : 'btn--ghost']} href={site.phoneHref}>
                    Call to book
                  </a>
                  <a class="text-link" href={`mailto:${site.email}?subject=${encodeURIComponent(p.name + ' inquiry')}`}>
                    or email us
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <div class="custom">
        <h2>Need something in between?</h2>
        <p>
          <strong>Partial planning</strong> and <strong>smaller day-of packages</strong> are available. Tell us what
          you’ve already handled and we’ll build a package around what’s left.
        </p>
        <p class="contact">
          <a href={site.phoneHref}>{site.phone}</a> · <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="section-head">
        <span class="eyebrow">Wedding FAQ</span>
        <h2>Common questions</h2>
        <Divider />
      </div>
      <FaqList items={weddingFaqs} />
      <p class="more-faq"><a href="/faq">See all FAQs →</a></p>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container narrow">
      <div class="section-head">
        <span class="eyebrow">Travel</span>
        <h2>Anywhere you celebrate</h2>
        <Divider />
      </div>
      <TravelNote />
    </div>
  </section>

  <ContactBand />
</Layout>

<style>
  .packages {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: start;
    max-width: 1040px;
    margin: 0 auto;
  }
  .pkg {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(32px, 4vw, 48px);
    background: var(--cream);
    border: 1px solid var(--line);
    border-top: 3px solid var(--copper);
    border-radius: var(--radius);
  }
  .featured { background: var(--ink); color: var(--cream); border-color: var(--ink); border-top-color: var(--copper); }
  .badge {
    position: absolute;
    top: -14px;
    right: 32px;
    background: var(--sheen);
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: var(--radius);
  }
  .theme { font-family: var(--script); font-size: 2rem; line-height: 1; color: var(--copper-deep); }
  .featured .theme { color: var(--copper); }
  .pkg h2 { font-size: clamp(2rem, 3.5vw, 2.5rem); margin: 0.35rem 0 0.25rem; }
  .price {
    display: inline-block;
    align-self: flex-start;
    font-family: var(--serif);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--copper-deep);
    margin-bottom: 1rem;
  }
  .featured .price {
    background: var(--sheen);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hook { font-family: var(--serif); font-size: 1.3rem; font-style: italic; line-height: 1.35; margin-bottom: 0.75rem; }
  .blurb { color: var(--ink-soft); }
  .featured .blurb { color: rgba(247, 240, 232, 0.8); }

  .sparkle-list { margin-bottom: 1rem; font-size: 0.98rem; }

  details { margin-bottom: 1.5rem; }
  summary {
    cursor: pointer;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--copper-deep);
    padding: 8px 0;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: ' +'; }
  details[open] summary::after { content: ' −'; }
  details[open] summary { margin-bottom: 0.5rem; }
  .featured summary { color: var(--copper); }

  .foot { margin-top: auto; }
  .note { font-style: italic; color: var(--ink-soft); font-size: 0.95rem; }
  .featured .note { color: rgba(247, 240, 232, 0.7); }
  .btn-row { align-items: center; gap: 16px; }
  .text-link { font-weight: 700; }
  .featured .text-link { color: var(--copper); }
  .featured .text-link:hover { color: var(--cream); }

  .custom {
    max-width: 720px;
    margin: clamp(48px, 7vw, 72px) auto 0;
    text-align: center;
  }
  .custom h2 { font-size: clamp(1.8rem, 3vw, 2.25rem); }
  .custom p { color: var(--ink-soft); }
  .contact { font-weight: 700; }

  .narrow { max-width: 860px; }
  .more-faq { margin-top: 1.5rem; font-weight: 700; }

  @media (max-width: 860px) {
    .packages { grid-template-columns: 1fr; max-width: 560px; gap: 40px; }
  }
</style>
