---
import Layout from '../layouts/Layout.astro';
import Divider from '../components/Divider.astro';
import Photo from '../components/Photo.astro';
import ContactBand from '../components/ContactBand.astro';
import Credentials from '../components/Credentials.astro';
import { photos, photosIn } from '../data/photos';
import { site } from '../data/site';

const portrait = photosIn('about')[0];
const behindTheScenes = photos.find((p) => p.alt === 'steaming the wedding gown before the ceremony');

const values = [
  { title: 'We listen first', text: 'Every plan starts with what matters most to you, not a template.' },
  { title: 'We sweat the details', text: 'Timelines, vendors, place cards and boutonnieres, all handled.' },
  { title: 'We’re there on the day', text: 'Cueing the music, greeting guests, and solving problems before you notice them.' },
];
---

<Layout
  title="Meet Peggy Foxworthy, Founder"
  description={`Meet Peggy Foxworthy, founder of ${site.name}: a Type A event planner in Vancouver, WA who handles every detail so hosts can relax and enjoy their own wedding or celebration.`}
  schema={[
    {
      '@type': 'Person',
      name: 'Peggy Foxworthy',
      jobTitle: 'Founder & Event Planner',
      worksFor: { '@id': `${site.url}/#business` },
      image: portrait ? new URL(portrait.src.src, site.url).href : undefined,
    },
  ]}
>
  <section class="section">
    <div class="container split">
      <div class="portrait">
        <Photo photo={portrait} label="Founder photo" width={720} ratio="4 / 5" loading="eager" class="portrait-img" />
      </div>
      <div>
        <span class="eyebrow">Meet Peggy</span>
        <h1>The heart behind <span class="script">Foxy Events</span></h1>
        <Divider />
        <p class="lede">
          Hi, I’m Peggy! I’ve always loved events and the excitement of bringing people together to celebrate life’s special moments.
        </p>
        <p>
          I love being part of it all: the planning, the details, the anticipation, and most of all, making sure the day
          comes together perfectly.
        </p>
        <p class="sig">— Peggy Foxworthy, Founder</p>
        <Credentials class="about-cred" />
        <div class="btn-row">
          <a class="btn btn--solid" href="/contact">Let’s talk</a>
          <a class="btn btn--ghost" href="/gallery">See our work</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container story">
      <div class="story-text">
        <h2>A planner who loves a checklist</h2>
        <Divider />
        <p>
          I’m naturally Type A. I genuinely enjoy being organized, planning ahead, and thinking through every little
          detail. I’m the person who likes a plan, a checklist, and knowing exactly what needs to happen next!
        </p>
        <p>
          But I also know that even the best plans need someone who can stay calm and handle whatever the day brings.
          That’s a big part of why I turned my love for events into Foxy Events.
        </p>

        <h2 class="second">Letting you enjoy your own event</h2>
        <Divider />
        <p>
          One of the things I’m most passionate about is giving hosts the chance to actually enjoy their own event. So
          often, the person hosting is so busy making sure everything runs smoothly that they miss the very moments they
          worked so hard to create.
        </p>
        <p class="come-in"><span class="script">That’s where I come in.</span></p>
        <p>
          I take care of the details, keep everything organized and on track, and am the person you can rely on from
          start to finish. My goal is to lift the stress and responsibility off your shoulders so you can relax, enjoy
          your guests, dance, laugh, celebrate, and truly be present in the moment.
        </p>
      </div>

      {
        behindTheScenes && (
          <figure class="bts">
            <Photo photo={behindTheScenes} label="" width={640} ratio="3 / 4" />
            <figcaption>Behind the scenes: steaming the gown before a ceremony at Edmonds Yacht Club.</figcaption>
          </figure>
        )
      }
    </div>
  </section>

  <section class="section section--dark quote">
    <div class="container">
      <p class="pull">
        For me, it’s not just about an event looking beautiful. It’s about creating an experience where you feel
        confident, cared for, and <span class="script">free to enjoy your day.</span>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="values">
        {
          values.map((v) => (
            <div>
              <h2>{v.title}</h2>
              <p>{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <ContactBand />
</Layout>

<style>
  .split {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .portrait { position: relative; }
  .portrait::before {
    content: '';
    position: absolute;
    inset: 24px -24px -24px 24px;
    border: 1px solid var(--copper);
    border-radius: var(--radius);
  }
  .portrait :global(.portrait-img) { position: relative; object-position: center 20%; }
  .sig { font-family: var(--serif); font-size: 1.4rem; font-style: italic; color: var(--copper-deep); margin: 1.5rem 0 1rem; }
  .split :global(.about-cred) { margin-bottom: 2rem; }

  .story {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .story-text { max-width: 640px; }
  .story-text p { color: var(--ink-soft); }
  .second { margin-top: 2.5rem; }
  .come-in { font-size: 1.6rem; margin: 1.5rem 0; }
  .come-in .script { font-size: 1.4em; }
  .bts { margin: 0; position: sticky; top: 104px; }
  .bts figcaption { margin-top: 12px; font-size: 0.9rem; font-style: italic; color: var(--ink-soft); }

  .quote { text-align: center; }
  .pull {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    line-height: 1.35;
    max-width: 32ch;
    margin: 0 auto;
    text-wrap: balance;
  }

  .values { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; text-align: center; }
  .values h2 { font-size: 1.7rem; }
  .values p { color: var(--ink-soft); margin: 0; }

  @media (max-width: 800px) {
    .split, .story, .values { grid-template-columns: 1fr; }
    .portrait { max-width: 420px; margin-inline: auto; width: calc(100% - 24px); margin-left: 0; }
    .bts { position: static; max-width: 420px; }
  }
</style>
