---
import Layout from '../layouts/Layout.astro';
import Divider from '../components/Divider.astro';
import TravelNote from '../components/TravelNote.astro';
import { site } from '../data/site';

const tips = ['Type of event (wedding, shower, business, fundraiser…)', 'Date (or a range)', 'Location or city', 'Estimated guest count', 'Budget range'];
---

<Layout
  title="Contact Our Vancouver, WA Event Planners"
  description={`Call or email ${site.name} to start planning your event. Based in Vancouver, WA, with free travel within 100 miles.`}
>
  <section class="section">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Contact</span>
        <h1>Let’s start <span class="script">planning</span></h1>
        <Divider align="center" />
        <p class="lede">{site.responseTime}</p>
      </div>

      <div class="methods">
        <a class="method" href={site.phoneHref}>
          <span class="label">Call or text</span>
          <span class="value">{site.phone}</span>
        </a>
        <a class="method" href={`mailto:${site.email}?subject=Event%20inquiry`}>
          <span class="label">Email</span>
          <span class="value">{site.email}</span>
        </a>
      </div>

      <div class="details">
        <div class="tips">
          <h2>Helpful to include</h2>
          <ul class="sparkle-list">{tips.map((t) => <li>{t}</li>)}</ul>
        </div>
        <TravelNote />
      </div>

      {
        site.socials.length > 0 && (
          <p class="social">
            Follow along:
            {site.socials.map((s, i) => <>{i > 0 && ' · '}<a href={s.href} rel="noopener">{s.label}</a></>)}
          </p>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .methods {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    max-width: 900px;
    margin: 0 auto;
  }
  .method {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: clamp(28px, 5vw, 48px);
    background: var(--ink);
    color: var(--cream);
    text-decoration: none;
    border-radius: var(--radius);
    text-align: center;
    transition: background 0.2s;
  }
  .method:hover { background: var(--copper); color: var(--ink); }
  .method:hover .label { color: var(--ink); }
  .label { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--copper); }
  .value { font-family: var(--serif); font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 600; overflow-wrap: anywhere; }

  .details {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 32px;
    max-width: 1000px;
    margin: 64px auto 0;
    align-items: start;
  }
  .tips h2 { font-size: 1.6rem; }
  .social { text-align: center; margin-top: 48px; }

  @media (max-width: 760px) {
    .methods, .details { grid-template-columns: 1fr; }
  }
</style>
